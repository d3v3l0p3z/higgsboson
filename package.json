{
  "name": "higgsboson",
  "version": "0.1.0",
  "private": true,
  "license": "gpl-3.0",
  "author": {
    "name": "Javier Lopez de Ancos",
    "email": "javierlopezdeancos@outlook.com",
    "url": "https://javierlopezdeancos.dev/"
  },
  "description": "Semantic classless framework to style native components.",
  "homepage": "https://higgsboson.org/",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/higgsboson/higgsboson.git"
  },
  "bugs": {
    "url": "https://codeberg.org/higgsboson/higgsboson/issues"
  },
  "keywords": [
    "css",
    "framework",
    "themeable",
    "semantic",
    "classless",
    "components",
    "design-system"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=12.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "./packages/themes/*",
    "./packages/core",
    "./packages/utils"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core:default": "npm run build --workspace packages/core",
    "build:theme:captain-america": "npm run build --workspace packages/themes/captain-america",
    "build:theme:caramel": "npm run build --workspace packages/themes/caramel",
    "deps:check": "npx depcheck --workspaces",
    "deps:install": "npm install --workspaces",
    "deps:remove": "npx npkill --workspaces",
    "deps:update": "npx npm-check-updates -u --workspaces",
    "dev": "npm run dev --workspaces",
    "dev:core:default": "npm run dev --workspace packages/core",
    "dev:theme:captain-america": "concurrently \"npm run dev:core:default\" \"npm run dev --workspace packages/themes/captain-america\"",
    "dev:theme:caramel": "concurrently \"npm run dev:core:default\" \"npm run dev --workspace packages/themes/caramel\"",
    "format": "npm run format --workspaces",
    "format:core:default": "npm run format --workspace packages/core",
    "format:theme:captain-america": "npm run format --workspace packages/themes/captain-america",
    "format:theme:caramel": "npm run format --workspace packages/themes/caramel",
    "format:utils": "npm run format --workspace packages/utils",
    "mocks:update:utils": "npm run mocks:update --workspace packages/utils",
    "lint": "npm run lint --workspaces",
    "lint:core:default": "npm run lint --workspace packages/core",
    "lint:theme:captain-america": "npm run lint --workspace packages/themes/captain-america",
    "lint:theme:caramel": "npm run lint --workspace packages/themes/caramel",
    "prepare": "husky",
    "pre-push": "npm run lint --workspaces",
    "test:utils": "npm run test --workspace packages/utils",
    "test:visual": "npm run test:visual --workspace packages/core",
    "test:visual:update": "npm run test:visual --workspace packages/core -- --update-snapshots",
    "test:coverage:recap:utils": "npm run test:coverage:recap --workspace packages/utils",
    "test:coverage:report:utils": "npm run test:coverage:report --workspace packages/utils",
    "test:watch:utils": "npm run test:watch --workspace packages/utils",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "publish:core": "npm publish --workspace packages/core",
    "publish:captain-america": "npm publish --workspace packages/themes/captain-america",
    "publish:caramel": "npm publish --workspace packages/themes/caramel",
    "publish:stage:core": "npm run publish:stage --workspace packages/core",
    "publish:stage:captain-america": "npm run publish:stage --workspace packages/themes/captain-america",
    "publish:stage:caramel": "npm run publish:stage --workspace packages/themes/caramel",
    "publish:stage:all": "npm run publish:stage:core && npm run publish:stage:captain-america && npm run publish:stage:caramel",
    "publish:promote:core": "npm run publish:promote --workspace packages/core",
    "publish:promote:captain-america": "npm run publish:promote --workspace packages/themes/captain-america",
    "publish:promote:caramel": "npm run publish:promote --workspace packages/themes/caramel",
    "publish:promote:all": "npm run publish:promote:core && npm run publish:promote:captain-america && npm run publish:promote:caramel"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.30.0",
    "@lcov-viewer/cli": "^1.3.0",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.3",
    "cssnano-preset-advanced": "^7.0.3",
    "husky": "^9.0.11",
    "jsdom": "^26.0.0",
    "lite-server": "^2.6.1",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "postcss-copy-assets": "^0.3.1",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^12.1.5",
    "postcss-preset-env": "^9.5.14",
    "postcss-reporter": "^7.1.0",
    "standard-version": "^9.5.0",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-use-nesting": "^5.1.1"
  }
}
